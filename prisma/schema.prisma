generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  GENERAL_MANAGER
  MANAGER
  LOADER
  SALESMAN
  TESTER
}

enum BranchType {
  BRANCH
  WAREHOUSE
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  DEBT
  WRITE_OFF
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

enum CylinderMovementType {
  DAILY_LOAD_FULL
  SALE_FULL_DELIVERED
  CUSTOMER_EMPTY_RETURNED
  DAILY_RETURN_FULL
  DAILY_RETURN_EMPTY
  STOCK_ADJUSTMENT
}

enum ReconciliationStatus {
  MORNING_RECORDED
  DISCREPANCY_PENDING
  EVENING_RECONCILED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  address   String
  vatNumber String
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id                  String    @id @default(cuid())
  companyId           String
  parentBranchId      String?
  type                BranchType @default(BRANCH)
  name                String
  location            String?
  code                String    @unique
  defaultCurrency     String    @default("OMR")
  defaultPhoneCode    String    @default("+968")
  defaultTaxRate      Decimal   @default(5.0000) @db.Decimal(7, 4)
  company             Company   @relation(fields: [companyId], references: [id])
  parentBranch        Branch?   @relation("BranchWarehouses", fields: [parentBranchId], references: [id])
  warehouses          Branch[]  @relation("BranchWarehouses")
  users               User[]
  customers           Customer[]
  products            Product[]
  priceRules          ProductPriceRule[]
  invoices            Invoice[]
  inventoryBalances   InventoryBalance[]
  cylinderMovements   CylinderMovement[]
  cylinders           Cylinder[]
  cylinderEvents      CylinderEvent[]
  dailyReconciliations DailyReconciliation[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@index([parentBranchId])
}

model User {
  id                    String             @id @default(cuid())
  branchId              String?
  role                  UserRole
  roleId                String?            @map("customRoleId")
  fullName              String
  phone                 String?
  email                 String?            @unique
  passwordHash          String?
  isActive              Boolean            @default(true)
  hasGlobalAccess       Boolean            @default(false)
  allowGlobalSalesView  Boolean            @default(false)
  sessionVersion        Int                @default(1)
  failedLoginAttempts   Int                @default(0)
  lockedUntil           DateTime?
  mfaSecret             String?
  mfaEnabled            Boolean            @default(false)
  mfaRecoveryCodes      String?            // JSON array of bcrypt hashes of one-time recovery codes
  // Marked true only for the master tester account and the canonical test users
  // it can impersonate. The impersonation server action refuses any target
  // where isTestUser=false. The column is additive (defaults to false), so
  // existing human users are unaffected and never impersonable.
  isTestUser            Boolean            @default(false)
  branch                Branch?            @relation(fields: [branchId], references: [id])
  roleProfile           Role?              @relation(fields: [roleId], references: [id])
  salesInvoices         Invoice[]          @relation("SalesmanInvoices")
  loaderReconciliations DailyReconciliation[] @relation("LoaderReconciliations")
  salesmanReconciliations DailyReconciliation[] @relation("SalesmanReconciliations")
  approvedReconciliations DailyReconciliation[] @relation("ReconciliationApprovals")
  debtPayments          DebtPayment[]
  auditLogs             AuditLog[]          @relation("AuditActor")
  effectiveAuditLogs    AuditLog[]          @relation("AuditEffectiveUser")
  cylinderEvents        CylinderEvent[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([branchId])
  @@index([roleId])
  @@index([role])
  @@index([isTestUser])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String
  effectiveUserId String?
  action          String
  targetModel     String
  targetId        String
  oldValue        Json?
  newValue        Json?
  timestamp       DateTime @default(now())
  ipAddress       String
  userAgent       String
  user            User     @relation("AuditActor", fields: [userId], references: [id])
  effectiveUser   User?    @relation("AuditEffectiveUser", fields: [effectiveUserId], references: [id])

  @@index([userId, timestamp])
  @@index([effectiveUserId, timestamp])
  @@index([targetModel, targetId])
}

model Customer {
  id            String      @id @default(cuid())
  branchId      String
  name          String
  customerNumber String @unique
  phone         String?
  address       String?
  phoneCode     String?
  vatNumber     String?
  taxRate       Decimal?    @db.Decimal(7, 4)
  creditLimit   Decimal?    @db.Decimal(12, 3)
  creditBalance Decimal     @default(0) @db.Decimal(12, 3)
  // Tokenized, read-only access to this customer's statements (no login required).
  shareToken        String?   @unique
  shareTokenExpires DateTime?
  branch        Branch      @relation(fields: [branchId], references: [id])
  invoices      Invoice[]
  debts         CustomerDebt[]
  cylinders     Cylinder[]         @relation("CylinderCustomer")
  cylinderEvents CylinderEvent[]    @relation("CylinderEventCustomer")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([branchId])
  @@index([name])
  @@index([phone])
}

model Product {
  id                  String              @id @default(cuid())
  branchId            String?
  sku                 String              @unique
  name                String
  gasType             String
  cylinderSize        String
  pressure            String?
  unitLabel           String              @default("Cylinder")
  isActive            Boolean             @default(true)
  branch              Branch?             @relation(fields: [branchId], references: [id])
  priceRules          ProductPriceRule[]
  invoiceItems        InvoiceItem[]
  inventoryBalances   InventoryBalance[]
  cylinderMovements   CylinderMovement[]
  cylinders           Cylinder[]
  dailyReconciliationItems DailyReconciliationItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([branchId])
  @@index([gasType])
}

model ProductPriceRule {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  currency  String   @default("OMR")
  minPrice  Decimal  @db.Decimal(12, 3)
  maxPrice  Decimal  @db.Decimal(12, 3)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, productId])
  @@index([startsAt, endsAt])
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  invoiceSerial     String?       @unique
  submissionToken   String?       @unique
  branchId          String
  customerId        String
  salesmanId        String
  status            InvoiceStatus @default(ISSUED)
  currency          String        @default("OMR")
  taxRate           Decimal       @db.Decimal(7, 4)
  subtotalAmount    Decimal       @db.Decimal(12, 3)
  taxAmount         Decimal       @db.Decimal(12, 3)
  totalAmount       Decimal       @db.Decimal(12, 3)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 3)
  writtenOffAmount  Decimal       @default(0) @db.Decimal(12, 3)
  debtAmount        Decimal       @default(0) @db.Decimal(12, 3)
  debtCollectionAmount Decimal?    @default(0) @db.Decimal(12, 3)
  customerCredit    Decimal       @default(0) @db.Decimal(12, 3)
  creditApplied     Decimal       @default(0) @db.Decimal(12, 3)
  notes             String?
  receiptPdfUrl     String?
  branch            Branch        @relation(fields: [branchId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  salesman          User          @relation("SalesmanInvoices", fields: [salesmanId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  customerDebts     CustomerDebt[]
  cylinderMovements CylinderMovement[]
  cylinderEvents    CylinderEvent[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([salesmanId])
}

model InvoiceItem {
  id                      String   @id @default(cuid())
  invoiceId               String
  productId               String
  fullCylindersDelivered  Int
  emptyCylindersReturned  Int      @default(0)
  unitPrice               Decimal  @db.Decimal(12, 3)
  lineSubtotal            Decimal  @db.Decimal(12, 3)
  invoice                 Invoice  @relation(fields: [invoiceId], references: [id])
  product                 Product  @relation(fields: [productId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  method           PaymentMethod
  amount           Decimal       @db.Decimal(12, 3)
  referenceNumber  String?
  attachmentUrl    String?
  bankName         String?
  checkDate        DateTime?
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([invoiceId])
  @@index([method])
}

model CustomerDebt {
  id             String      @id @default(cuid())
  customerId     String
  invoiceId      String
  originalAmount Decimal     @db.Decimal(12, 3)
  balanceAmount  Decimal     @db.Decimal(12, 3)
  dueDate        DateTime?
  status         DebtStatus  @default(OPEN)
  customer       Customer    @relation(fields: [customerId], references: [id])
  invoice        Invoice     @relation(fields: [invoiceId], references: [id])
  payments       DebtPayment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([customerId, status])
  @@index([invoiceId])
}

model DebtPayment {
  id             String       @id @default(cuid())
  debtId         String
  collectedById  String
  method         PaymentMethod
  amount         Decimal      @db.Decimal(12, 3)
  referenceNumber String?
  attachmentUrl  String?
  debt           CustomerDebt @relation(fields: [debtId], references: [id])
  collectedBy    User         @relation(fields: [collectedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([debtId])
  @@index([collectedById])
}

model DailyReconciliation {
  id                  String                  @id @default(cuid())
  branchId            String
  salesmanId          String
  loaderId            String
  reconciliationDate  DateTime                @db.Date
  morningLoggedAt     DateTime                @default(now())
  eveningReconciledAt DateTime?
  status              ReconciliationStatus    @default(MORNING_RECORDED)
  notes               String?
  discrepancyApprovedById String?
  discrepancyApprovedAt DateTime?
  discrepancyReason   String?
  branch              Branch                  @relation(fields: [branchId], references: [id])
  salesman            User                    @relation("SalesmanReconciliations", fields: [salesmanId], references: [id])
  loader              User                    @relation("LoaderReconciliations", fields: [loaderId], references: [id])
  discrepancyApprovedBy User?                 @relation("ReconciliationApprovals", fields: [discrepancyApprovedById], references: [id])
  items               DailyReconciliationItem[]
  movements           CylinderMovement[]
  cylinderEvents      CylinderEvent[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([salesmanId, reconciliationDate])
  @@index([branchId, reconciliationDate])
  @@index([salesmanId, reconciliationDate])
  @@index([discrepancyApprovedById])
}

model DailyReconciliationItem {
  id                  String              @id @default(cuid())
  reconciliationId    String
  productId           String
  morningFull         Int                 @default(0)
  eveningReturnedFull Int                 @default(0)
  eveningReturnedEmpty Int                @default(0)
  missingEmpty        Int                 @default(0)
  soldFull            Int                 @default(0)
  invoiceSoldFull     Int                 @default(0)
  invoiceEmptyReturned Int                @default(0)
  varianceFull        Int                 @default(0)
  varianceEmpty       Int                 @default(0)
  reconciliation      DailyReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])

  @@unique([reconciliationId, productId])
  @@index([productId])
}

model InventoryBalance {
  id             String   @id @default(cuid())
  branchId       String
  productId      String
  fullCount      Int      @default(0)
  emptyCount     Int      @default(0)
  branch         Branch   @relation(fields: [branchId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
  updatedAt      DateTime @updatedAt

  @@unique([branchId, productId])
}

model CylinderMovement {
  id             String               @id @default(cuid())
  branchId       String
  productId      String
  invoiceId      String?
  reconciliationId String?
  type           CylinderMovementType
  fullDelta      Int                  @default(0)
  emptyDelta     Int                  @default(0)
  note           String?
  branch         Branch               @relation(fields: [branchId], references: [id])
  product        Product              @relation(fields: [productId], references: [id])
  invoice        Invoice?             @relation(fields: [invoiceId], references: [id])
  reconciliation DailyReconciliation? @relation(fields: [reconciliationId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([branchId, productId, createdAt])
  @@index([invoiceId])
  @@index([reconciliationId])
}

// Per-cylinder serial tracking (optional, additive). Existing count-based flow is
// untouched; serials are recorded here when operators choose to scan/track them.
enum CylinderStatus {
  AVAILABLE
  FILLED
  OUT
  RETURNED
  RETIRED
}

model Cylinder {
  id           String        @id @default(cuid())
  branchId     String
  productId    String
  serial       String
  status       CylinderStatus @default(AVAILABLE)
  location     String? // e.g. "Warehouse", "In transit - <salesman>", "Customer <name>"
  customerId   String?
  branch       Branch        @relation(fields: [branchId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  customer     Customer?     @relation("CylinderCustomer", fields: [customerId], references: [id])
  events       CylinderEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([branchId, serial])
  @@index([branchId])
  @@index([productId])
  @@index([status])
  @@index([customerId])
}

model CylinderEvent {
  id               String               @id @default(cuid())
  cylinderId       String
  branchId         String
  type             CylinderMovementType
  invoiceId        String?
  reconciliationId  String?
  salesmanId       String?
  customerId       String?
  note             String?
  createdAt        DateTime            @default(now())
  cylinder         Cylinder            @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  branch           Branch              @relation(fields: [branchId], references: [id])
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id])
  reconciliation   DailyReconciliation? @relation(fields: [reconciliationId], references: [id])
  salesman         User?               @relation(fields: [salesmanId], references: [id])
  customer         Customer?          @relation("CylinderEventCustomer", fields: [customerId], references: [id])

  @@index([cylinderId, createdAt])
  @@index([branchId])
  @@index([customerId])
}
