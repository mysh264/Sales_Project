POSTGRES_DB=sales_tracking
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://sales_user:replace-with-a-url-encoded-password@db:5432/sales_tracking?schema=public
APP_ORIGIN=https://sales.example.com
UPLOAD_DIR=./storage/uploads
SEED_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=replace-only-when-demo-users-are-enabled
AUDIT_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=30
# Master Tester feature (dev/test only). When MASTERTESTER_ENABLED=true,
# the database seed creates the master tester account and the 11 canonical
# test users (one per role+branch), and the /tester launchpad becomes
# reachable. Leave this false in any production deploy.
MASTERTESTER_ENABLED=false
MASTERTESTER_EMAIL=tester@mahmoudbox.com
MASTERTESTER_PASSWORD=replace-with-a-strong-tester-password
TESTER_CANNONICAL_PASSWORD=replace-with-a-strong-test-users-password
